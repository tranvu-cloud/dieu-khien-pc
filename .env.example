# Copy this file to ".env" and fill in your values.

# The URL of your deployed relay server (from Railway/Render), e.g.:
# SERVER_URL=https://remote-pc-server-production.up.railway.app
SERVER_URL=

# Optional: set a password so viewers must enter it to connect. Leave blank for none.
PASSWORD=

# How many screen frames per second to stream. 5-8 is a good balance for
# remote admin use over the internet. Higher = smoother but more bandwidth.
FPS=6

# JPEG quality 1-100. Lower = smaller/faster, higher = sharper.
QUALITY=60
